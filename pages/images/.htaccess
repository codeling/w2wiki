# Uploaded files are served by the wiki (file.php), with the same password and IP
# checks as the pages: the web server must not serve them directly, also not through
# a link or alias left over from earlier versions (see "Uploaded files" in INSTALL.md).
Require all denied

# ... and nothing in here may ever be executed by the web server.
<FilesMatch "(?i)\.(php[0-9]?|pht|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
	Require all denied
</FilesMatch>

<IfModule mod_php.c>
	php_flag engine off
</IfModule>
<IfModule mod_php7.c>
	php_flag engine off
</IfModule>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .pht .phtml .phar
RemoveType .php .php3 .php4 .php5 .php7 .php8 .pht .phtml .phar
