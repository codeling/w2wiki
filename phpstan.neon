includes:
    - phpstan-baseline.neon

parameters:
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    level: 1
    phpVersion:
        min: 80100
        max: 80499
    paths:
        - index.php
        - api.php
        - auth.php
        - auth_functions.php
        - functions.php
        - defaults.php
        - config.sample.php
        - src
    excludePaths:
        - Michelf
        - vendor
        - tests
